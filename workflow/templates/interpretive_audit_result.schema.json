{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ELARA Stage 12 interpretive audit result (one coded observation)",
  "type": "object",
  "required": ["disposition", "reasoning", "locations_inspected"],
  "additionalProperties": false,
  "properties": {
    "disposition": {"enum": ["supported", "unsupported", "ambiguous"]},
    "reasoning": {"type": "string", "minLength": 1, "maxLength": 2000},
    "locations_inspected": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
